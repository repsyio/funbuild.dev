<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Framework-managed entities/controllers and generated transport models expose references by design. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>
  <Match>
    <Class name="~dev\.funbuild\.api\.model\..*"/>
  </Match>
</FindBugsFilter>
